@page
@using SmartCare.Domain.Common
@model SmartCare.Web.Pages.WaitingRoom.RecordModel
@{
    ViewData["Title"] = "Record Journey Event";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Record Patient Journey Event</h2>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">← Back to Live Queue</a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Patient MRN <span class="text-danger">*</span></label>
                <input type="text" name="mrn" class="form-control"
                       placeholder="e.g. MRN-000001" required
                       value="@Model.Mrn" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Station <span class="text-danger">*</span></label>
                <select name="station" class="form-select" required>
                    @foreach (var s in Enum.GetValues<JourneyStation>())
                    {
                        <option value="@s" selected="@(s == Model.SelectedStation)">@s</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Event Type <span class="text-danger">*</span></label>
                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="eventType"
                               value="@JourneyEventType.Enter" id="evtEnter" checked />
                        <label class="form-check-label" for="evtEnter">
                            ➡️ Enter Station
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="eventType"
                               value="@JourneyEventType.Leave" id="evtLeave" />
                        <label class="form-check-label" for="evtLeave">
                            ⬅️ Leave Station
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Appointment ID (optional)</label>
                <input type="text" name="appointmentId" class="form-control"
                       placeholder="Leave blank if not associated with an appointment" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Record Event</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
