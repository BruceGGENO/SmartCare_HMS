@{
    var isStaffPharmacy = User.IsInRole(Roles.Pharmacist) || User.IsInRole(Roles.HospitalAdmin) || User.IsInRole(Roles.SuperAdmin);
    var isLabStaff = User.IsInRole(Roles.LabTechnician) || User.IsInRole(Roles.Nurse);
    var isDoctor = User.IsInRole(Roles.Doctor);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SmartCare HMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f3f4f6; }
        .card { border: 0; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .alert-error { background: #fde8ec; border: 1px solid #f5b5c1; color: #9f1239; }
        .allergy-banner { background: #fde8ec; border: 1px solid #f5b5c1; color: #9f1239; border-radius: .5rem; padding: .6rem 1rem; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">SmartCare HMS</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (isStaffPharmacy)
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Pharmacy/Index">Pharmacy</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Pharmacy/Drugs">Drugs</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Pharmacy/Stock">Stock</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Pharmacy/PurchaseOrders">Purchase orders</a></li>
                }
                @if (isLabStaff)
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Lab/Index">Lab worklist</a></li>
                }
                @if (User.IsInRole(Roles.LabTechnician) || User.IsInRole(Roles.HospitalAdmin) || User.IsInRole(Roles.SuperAdmin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Lab/Tests">Test catalog</a></li>
                }
                @if (isDoctor)
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Pharmacy/Prescribe">Prescribe</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Lab/Order">Order test</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Lab/Results">Lab results</a></li>
                }
                @if (isDoctor || User.IsInRole(Roles.Nurse) || User.IsInRole(Roles.HospitalAdmin) || User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.BillingStaff) || User.IsInRole(Roles.Pharmacist) || User.IsInRole(Roles.LabTechnician))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Discharge/Index">Discharge</a></li>
                }
                @if (User.IsInRole(Roles.Receptionist) || User.IsInRole(Roles.Nurse) || isDoctor || User.IsInRole(Roles.HospitalAdmin) || User.IsInRole(Roles.SuperAdmin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/WaitingRoom/Index">Waiting Room</a></li>
                }
                @if (User.IsInRole(Roles.HospitalAdmin) || User.IsInRole(Roles.SuperAdmin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/WaitingRoom/Analytics">Queue Analytics</a></li>
                }
            </ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3">@User.Identity.Name</span>
                <form method="post" asp-page="/Account/Logout"><button class="btn btn-outline-light btn-sm">Sign out</button></form>
            }
        </div>
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-error">@err</div>
    }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
