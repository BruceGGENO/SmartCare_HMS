@model InvoiceDto

@{
    ViewData["Title"] = $"Invoice #{Model.Id:D4} Details";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            &larr; Back to Invoices
        </a>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Invoice #@Model.Id.ToString("D4")</h2>
                <p class="text-muted mb-0">Created on @Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
            </div>
            <div>
                @if (Model.Status == "Paid")
                {
                    <span class="badge bg-success fs-5 px-3 py-2">Paid</span>
                }
                else if (Model.Status == "Partial")
                {
                    <span class="badge bg-warning text-dark fs-5 px-3 py-2">Partial Payment</span>
                }
                else
                {
                    <span class="badge bg-danger fs-5 px-3 py-2">Payment Pending</span>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Payment Successful!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Patient Info and Line Items -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary mb-3">Patient Information</h5>
                    <div class="row">
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Full Name</p>
                            <h6 class="fw-bold">@Model.PatientName</h6>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Medical Record Number (MRN)</p>
                            <h6><span class="badge bg-secondary fs-6">@Model.PatientMrn</span></h6>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 fw-bold">Billed Services & Items</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Description</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Lines.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">No line items attached.</td>
                                </tr>
                            }
                            else
                            {
                                int rowNumber = 1;
                                foreach (var line in Model.Lines)
                                {
                                    <tr>
                                        <td>@(rowNumber++)</td>
                                        <td class="fw-semibold">@line.Description</td>
                                        <td class="text-center">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-bold">@line.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total Amount:</td>
                                <td class="text-end fw-bold fs-6">@Model.TotalAmount.ToString("C")</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-success">Amount Paid:</td>
                                <td class="text-end fw-bold text-success">@Model.PaidAmount.ToString("C")</td>
                            </tr>
                            <tr class="table-active">
                                <td colspan="4" class="text-end fw-bold fs-5">Remaining Balance:</td>
                                <td class="text-end fw-bold fs-5 text-danger">@Model.Balance.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Payment Form -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Process Payment</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Balance <= 0)
                    {
                        <div class="text-center py-4">
                            <div class="text-success display-4 mb-3">✓</div>
                            <h5 class="fw-bold text-success">Invoice Fully Paid</h5>
                            <p class="text-muted mb-0">No outstanding balance remains on this invoice.</p>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Pay" method="post">
                            <input type="hidden" name="invoiceId" value="@Model.Id" />
                            <input type="hidden" name="paymentMethod" value="Mobile Money (MTN / Airtel)" />

                            <div class="mb-3">
                                <label class="form-label text-muted">Payment Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control form-control-lg fw-bold" 
                                           name="amount" value="@Model.Balance" max="@Model.Balance" min="0.01" required />
                                </div>
                                <small class="text-muted">You can pay in full or make partial payments.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">Mobile Money Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text">📱</span>
                                    <input type="tel" class="form-control" name="phoneNumber" 
                                           placeholder="e.g. 0788 123 456" 
                                           value="0788 123 456" required />
                                </div>
                                <small class="text-muted">MTN MoMo or Airtel Money number</small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold fs-6 mt-2">
                                Pay with Mobile Money
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
