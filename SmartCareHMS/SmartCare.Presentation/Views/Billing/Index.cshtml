@model IReadOnlyList<InvoiceDto>

@{
    ViewData["Title"] = "Billing & Invoices";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Billing & Invoicing</h2>
            <p class="text-muted mb-0">Manage patient invoices and process payments</p>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2 fs-6">
                @Model.Count(i => i.Status == "Pending") Pending Invoices
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info py-4 text-center">
            <h5 class="alert-heading mb-1">No Pending Invoices</h5>
            <p class="mb-0 text-muted">All patient accounts are currently up to date.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Patient</th>
                            <th>MRN</th>
                            <th>Date</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@invoice.Id.ToString("D4")</td>
                                <td>@invoice.PatientName</td>
                                <td><span class="badge bg-secondary">@invoice.PatientMrn</span></td>
                                <td>@invoice.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">@invoice.TotalAmount.ToString("C")</td>
                                <td class="text-end text-success">@invoice.PaidAmount.ToString("C")</td>
                                <td class="text-end fw-bold text-danger">@invoice.Balance.ToString("C")</td>
                                <td class="text-center">
                                    @if (invoice.Status == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.Status == "Partial")
                                    {
                                        <span class="badge bg-warning text-dark">Partial</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pending</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">
                                        View & Pay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
