@{
    ViewData["Title"] = "Upload document";
}

<h1>Upload document</h1>
<p class="text-muted">PDF, JPG or PNG. Maximum 5 MB. Files are stored outside wwwroot with GUID names.</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label" for="file">File</label>
        <input class="form-control" type="file" id="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="entityType">Linked entity type (optional)</label>
        <input class="form-control" id="entityType" name="entityType" placeholder="Patient" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="entityId">Linked entity id (optional)</label>
        <input class="form-control" id="entityId" name="entityId" placeholder="MRN or patient id" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>
