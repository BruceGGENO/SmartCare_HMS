@model SmartCare.Presentation.Models.RevenueDashboardViewModel
@{
    ViewData["Title"] = "Revenue vs. Usage Accounting";
    var earnedPct = Model.Summary.EarnedPercentage;
    var deferredPct = 100 - earnedPct;
}

<div class="container-fluid py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠ Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Revenue vs. Usage Accounting</h2>
            <p class="text-muted mb-0">Reconciliation dashboard for prepaid healthcare packages, deferred liability, and recognized session revenue.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#purchasePackageModal">
                + Purchase Package
            </button>
            <a asp-action="ExportCsv" class="btn btn-outline-success">
                📥 Export CSV Ledger
            </a>
        </div>
    </div>

    <!-- 1. KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body">
                    <div class="text-white-50 text-uppercase fw-bold small">Total Cash Collected</div>
                    <div class="display-6 fw-bold mt-2">$@Model.Summary.TotalCashCollected.ToString("N2")</div>
                    <div class="small mt-2 text-white-50">Across @Model.Summary.TotalPackagesCount total package(s)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body">
                    <div class="text-white-50 text-uppercase fw-bold small">Earned (Recognized) Revenue</div>
                    <div class="display-6 fw-bold mt-2">$@Model.Summary.TotalEarnedRevenue.ToString("N2")</div>
                    <div class="small mt-2 text-white-50">Recognized from delivered healthcare services</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-bold small">Deferred (Unearned) Liability</div>
                    <div class="display-6 fw-bold mt-2">$@Model.Summary.TotalDeferredRevenue.ToString("N2")</div>
                    <div class="small mt-2 text-muted">Awaiting patient session consumption</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-secondary text-white h-100">
                <div class="card-body">
                    <div class="text-white-50 text-uppercase fw-bold small">Sessions Consumption</div>
                    <div class="display-6 fw-bold mt-2">@Model.Summary.TotalSessionsConsumed <span class="fs-4 text-white-50">/ @Model.Summary.TotalSessionsSold</span></div>
                    <div class="small mt-2 text-white-50">@Model.Summary.RemainingSessions session(s) pending attendance</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Visual Reconciliation Comparison Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title fw-bold mb-0">Revenue Recognition Comparison (Earned vs. Deferred)</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <div>
                    <span class="badge bg-success me-1">&nbsp;</span>
                    <strong>Earned Revenue:</strong> $@Model.Summary.TotalEarnedRevenue.ToString("N2") (@earnedPct%)
                </div>
                <div>
                    <strong>Deferred Revenue:</strong> $@Model.Summary.TotalDeferredRevenue.ToString("N2") (@deferredPct%)
                    <span class="badge bg-warning ms-1">&nbsp;</span>
                </div>
            </div>
            <div class="progress" style="height: 28px; border-radius: 8px;">
                <div class="progress-bar bg-success fw-bold" role="progressbar" style="width: @(earnedPct)%;" aria-valuenow="@earnedPct" aria-valuemin="0" aria-valuemax="100">
                    @(earnedPct)% Recognized
                </div>
                <div class="progress-bar bg-warning text-dark fw-bold" role="progressbar" style="width: @(deferredPct)%;" aria-valuenow="@deferredPct" aria-valuemin="0" aria-valuemax="100">
                    @(deferredPct)% Deferred
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Prepaid Packages Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0">Prepaid Healthcare Packages</h5>
            <span class="badge bg-info text-dark">@Model.Packages.Count Total Packages</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th>Package Plan</th>
                        <th>Sessions (Used / Total)</th>
                        <th>Total Amount</th>
                        <th>Earned Revenue</th>
                        <th>Deferred Balance</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Packages.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No prepaid packages found. Click "+ Purchase Package" to register one!
                            </td>
                        </tr>
                    }
                    @foreach (var pkg in Model.Packages)
                    {
                        var sessionProgress = pkg.TotalSessions > 0 ? (int)((double)pkg.UsedSessions / pkg.TotalSessions * 100) : 0;
                        <tr>
                            <td>
                                <div class="fw-bold">@pkg.PatientName</div>
                                <div class="small text-muted">@pkg.PatientMrn</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@pkg.PackageName</div>
                                <div class="small text-muted">$@pkg.PricePerSession.ToString("N2") / session</div>
                            </td>
                            <td style="min-width: 160px;">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@pkg.UsedSessions / @pkg.TotalSessions</span>
                                    <span class="text-muted">(@pkg.RemainingSessions left)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @(pkg.Status == "Completed" ? "bg-secondary" : "bg-primary")" 
                                         role="progressbar" 
                                         style="width: @(sessionProgress)%"></div>
                                </div>
                            </td>
                            <td class="fw-bold">$@pkg.TotalAmount.ToString("N2")</td>
                            <td class="text-success fw-bold">$@pkg.EarnedRevenue.ToString("N2")</td>
                            <td class="text-warning fw-bold">$@pkg.DeferredRevenue.ToString("N2")</td>
                            <td>
                                @if (pkg.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Completed</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (pkg.RemainingSessions > 0)
                                {
                                    <form asp-action="ConsumeSession" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="packageId" value="@pkg.Id" />
                                        <input type="hidden" name="notes" value="Session attended at @DateTime.Now.ToString("g")" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Record 1 session usage">
                                            ✓ Consume 1 Session
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>Fully Consumed</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. Recent Session Consumption History -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="card-title fw-bold mb-0">Recent Consumption Ledger Logs</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Package Plan</th>
                        <th>Session #</th>
                        <th>Recognized Revenue</th>
                        <th>Clinical Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentUsages.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No session consumption recorded yet.
                            </td>
                        </tr>
                    }
                    @foreach (var usage in Model.RecentUsages)
                    {
                        <tr>
                            <td>@usage.ConsumedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-bold">@usage.PatientName</td>
                            <td>@usage.PackageName</td>
                            <td><span class="badge bg-info text-dark">Session @usage.SessionNumber</span></td>
                            <td class="text-success fw-bold">+$@usage.RecognizedAmount.ToString("N2")</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(usage.Notes) ? "Standard Session" : usage.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Purchase Package Modal -->
<div class="modal fade" id="purchasePackageModal" tabindex="-1" aria-labelledby="purchaseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Purchase" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="purchaseModalLabel">Purchase Prepaid Healthcare Package</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Patient Name</label>
                        <input type="text" class="form-control" name="PatientName" placeholder="e.g. David Mwangi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Patient MRN</label>
                        <input type="text" class="form-control" name="PatientMrn" placeholder="e.g. MRN-1008" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Package Name</label>
                        <input type="text" class="form-control" name="PackageName" placeholder="e.g. Physiotherapy 5-Pack" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Total Sessions</label>
                            <input type="number" class="form-control" name="TotalSessions" min="1" max="50" value="5" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Total Price ($)</label>
                            <input type="number" step="0.01" class="form-control" name="TotalAmount" min="1" value="250.00" required />
                        </div>
                    </div>
                    <input type="hidden" name="PatientId" value="1" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Complete Purchase</button>
                </div>
            </form>
        </div>
    </div>
</div>
